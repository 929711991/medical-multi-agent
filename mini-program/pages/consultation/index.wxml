<view class="page"><view class="warning">AI健康助手 · AI生成内容不替代医生诊疗</view><picker range="{{patients}}" range-key="name" bindchange="selectPatient"><view class="card">咨询对象：{{selectedName || '请选择健康档案'}}</view></picker><view class="messages"><view wx:for="{{messages}}" wx:key="id" class="bubble {{item.sender_type === 'PATIENT' ? 'mine' : 'assistant'}}"><text>{{item.content}}</text><text wx:if="{{item.metadata.information_completeness !== undefined}}" class="muted">信息完整度 {{item.metadata.information_completeness}}%</text></view></view><view wx:if="{{emergency}}" class="emergency">请立即拨打120或前往最近急诊，不要等待AI分析。</view><view class="composer"><textarea value="{{content}}" bindinput="content" placeholder="请描述症状、持续时间和严重程度"/><button class="primary" bindtap="send">发送</button></view><button wx:if="{{ready}}" class="primary action" bindtap="analyze">开始AI分析</button><button wx:if="{{canEscalate}}" class="action" bindtap="escalate">转人工医生审核</button></view>
