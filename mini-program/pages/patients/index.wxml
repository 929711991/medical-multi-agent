<view class="page"><view wx:if="{{error}}" class="warning">{{error}}</view><view wx:for="{{items}}" wx:key="patient_id" class="card"><text>{{item.name}}</text><text class="muted">{{item.relation_type}} · {{item.permission}}</text><text class="muted">患者自述：{{item.self_reported_history.join('、') || '暂无'}}</text></view><view class="card"><input placeholder="姓名" value="{{form.name}}" data-key="name" bindinput="input"/><picker range="{{relations}}" bindchange="relation"><view>关系：{{form.relation_type}}</view></picker><button class="primary" bindtap="create">新增本人/家庭成员档案</button></view></view>
